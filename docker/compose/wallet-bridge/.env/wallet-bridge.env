VIRTUAL_HOST=wallet-bridge.docker.dev-franceconnect.fr
APP_NAME=wallet-bridge
FQDN=wallet-bridge.docker.dev-franceconnect.fr
App_FQDN=wallet-bridge.docker.dev-franceconnect.fr
App_ASSETS_URL_DOMAIN=
OidcProvider_ISSUER=https://wallet-bridge.docker.dev-franceconnect.fr
LoggerLegacy_FILE=/var/log/app/wallet-bridge.log

PM2_SCRIPT=yarn start:dev wallet-bridge-instance
NESTJS_INSTANCE=wallet-bridge
DEFAULT_MODE=dev
PM2_CI_SCRIPT=yarn start:ci wallet-bridge-instance
REQUEST_TIMEOUT=6000

# App (shared)
App_SHOW_DEV_TOOLS=false
App_DEV_TOOLS_MOCK_URL=
App_ASSETS_PATHS=["../../../instances/wallet-bridge/src", "../../../apps/wallet-bridge/src"]
App_ASSETS_CACHE_TTL=31536000 # 1 year
App_ASSETS_URL_PREFIX=/assets/cache-busting-token
App_VIEWS_PATHS=["../../../instances/wallet-bridge/src", "../../../apps/wallet-bridge/src"]

# Cog
Cog_CITY_FILE=/var/databases/commune.csv
Cog_COUNTRY_FILE=/var/databases/country.csv
Cog_ISO_COUNTRY_FILE=/var/databases/country-iso3166-1-cog.csv

# Redis
Redis_DB=8
Redis_SENTINELS=[{"host": "fc_redis-sentinel_1", "port": 26379}, {"host": "fc_redis-sentinel_2", "port": 26379}, {"host": "fc_redis-sentinel_3", "port": 26379}]
Redis_CACERT=/etc/ssl/docker_host/docker-stack-ca.crt
Redis_ENABLE_TLS_FOR_SENTINEL_MODE=true
Redis_NAME=fc_core_v2
Redis_PASSWORD=Ivae1feiThoogahquohDei7iwie0ceeM

# Session
Session_ENCRYPTION_KEY=raePh3i+a4eiwieb-H5iePh6o/gheequ
Session_COOKIE_SECRETS=["Eigoh6ev8xaiNoox"]

