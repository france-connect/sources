PM2_SCRIPT=yarn start:dev mock-wallet-instance
NESTJS_INSTANCE=mock-wallet
APP_NAME=mock-wallet
DEFAULT_MODE=dev
PM2_CI_SCRIPT=yarn start:ci mock-wallet-instance
VIRTUAL_HOST=mock-wallet.docker.dev-franceconnect.fr
REQUEST_TIMEOUT=6000
FQDN=mock-wallet.docker.dev-franceconnect.fr

App_FQDN=mock-wallet.docker.dev-franceconnect.fr
App_VIEWS_PATHS=["../../../apps/mock-wallet/src"]

App_ASSETS_PATHS=["../../../instances/mock-wallet/src", "../../../apps/mock-wallet/src"]
App_VIEWS_PATHS=["../../../instances/mock-wallet/src", "../../../apps/mock-wallet/src"]
App_ASSETS_URL_PREFIX=/assets/cache-busting-token
App_ASSETS_URL_DOMAIN=
App_ASSETS_CACHE_TTL=31536000 # 1 year

App_HTTPS_SERVER_KEY=/etc/ssl/docker_host/server.key
App_HTTPS_SERVER_CERT=/etc/ssl/docker_host/server.crt
App_URL_PREFIX=/
App_NAME=mock-wallet

App_ALLOWED_ALGS=["ES256","RS256"]
App_ALLOWED_RESPONSE_MODES=["direct_post","direct_post.jwt"]
App_SKIP_SIGNATURE_VERIFICATION=true
App_PERMISSIVE_CONTENT_TYPE=true
