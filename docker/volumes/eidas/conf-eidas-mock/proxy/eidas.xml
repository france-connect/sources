<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>

	<entry key="service.id">CB</entry>
	<entry key="service.countrycode">CB</entry>
	<entry key="metadata.node.country">CB</entry>

	<entry key="active.module.service">true</entry>

	<!--service Metadata (auto-reference) -->
	<entry key="service.node.url">https://eidas-mock.docker.dev-franceconnect.fr/EidasNodeProxy/</entry>
	<entry key="service.contact.email">test@com</entry>
	<entry key="service.metadata.url">https://eidas-mock.docker.dev-franceconnect.fr/EidasNodeProxy/ServiceMetadata</entry>

	<!-- Eidas Node Service Metadata Single Sign On locations (auto-reference) -->
	<entry key="ssos.serviceMetadataGeneratorIDP.redirect.location">https://eidas-mock.docker.dev-franceconnect.fr/EidasNodeProxy/ColleagueRequest</entry>
	<entry key="ssos.serviceMetadataGeneratorIDP.post.location">https://eidas-mock.docker.dev-franceconnect.fr/EidasNodeProxy/ColleagueRequest</entry>

	<!-- Feature selector for security headers -->
	<entry key="security.header.CSP.report.uri">https://eidas-mock.docker.dev-franceconnect.fr/EidasNodeProxy</entry>
	<entry key="security.header.CSP.fallbackCheckMode">false</entry>

	<entry key="metadata.sector">public</entry>
	<entry key="hashDigest.className">org.bouncycastle.crypto.digests.SHA512Digest</entry>

	<entry key="tls.enabled.protocols">TLSv1.2, TLSv1.3</entry>

	<entry key="tls.enabled.ciphers">
		TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256,
		TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,
		TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384,
		TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,
		TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256,
		TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256,
		TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
		TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384,
		TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,
		TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256,
		TLS_DHE_RSA_WITH_AES_128_CBC_SHA256,
		TLS_DHE_RSA_WITH_AES_128_GCM_SHA256,
		TLS_DHE_RSA_WITH_AES_256_CBC_SHA256,
		TLS_DHE_RSA_WITH_AES_256_GCM_SHA384,
		TLS_AES_128_GCM_SHA256,
		TLS_AES_256_GCM_SHA384,
		TLS_CHACHA20_POLY1305_SHA256,
		TLS_EMPTY_RENEGOTIATION_INFO_SCSV
	</entry>

	<entry key="service.LoA">http://eidas.europa.eu/LoA/high;http://eidas.europa.eu/LoA/substantial;http://eidas.europa.eu/LoA/low</entry>

	<entry key="node.metadata.not.signed.descriptors"></entry>

	<!-- METADATA configuration -->
	<entry key="service.contact.support.email">contact.support@eidas-proxyservice.eu</entry>
	<entry key="service.contact.support.company">eIDAS ProxyService Operator</entry>
	<entry key="service.contact.support.givenname">John</entry>
	<entry key="service.contact.support.surname">Doe</entry>
	<entry key="service.contact.support.phone">+42 123456</entry>
	<entry key="service.contact.technical.email">contact.technical@eidas-proxyservice.eu</entry>
	<entry key="service.contact.technical.company">eIDAS ProxyService Operator</entry>
	<entry key="service.contact.technical.givenname">John</entry>
	<entry key="service.contact.technical.surname">Doe</entry>
	<entry key="service.contact.technical.phone">+43 123456</entry>
	<entry key="service.organization.name">Sample Country Proxy Service</entry>
	<entry key="service.organization.displayname">Service</entry>
	<entry key="service.organization.url">https://service.sample/info</entry>

	<!--URL for specific-proxyService requests receiver (auto-reference) -->
	<entry key="specific.proxyservice.request.receiver">https://eidas-mock.docker.dev-franceconnect.fr/SpecificProxyService/ProxyServiceRequest</entry>

	<entry key="eidas.application.identifier">eIDAS-ref:3.1.0</entry>

