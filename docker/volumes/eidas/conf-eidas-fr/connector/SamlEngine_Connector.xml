<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">

<properties>
	<comment>SAML constants for AuthnRequests and Responses.</comment>

	<!-- Types of consent obtained from the user for this authentication and
		data transfer. Allow values: 'obtained', 'prior', 'current-implicit', 'current-explicit',
		'unspecified', 'unavailable', 'inapplicable'.
		Verifie utilise : SAMLCore.CONSENT_REQ_TAG (SAMLEngine, pas de defaut) -->
	<entry key="consentAuthnRequest">unspecified</entry>

	<!--URI representing the classification of the identifier Allow values:
		'entity'. Verifie utilise : DefaultCoreProperties (pas de defaut) -->
	<entry key="formatEntity">entity</entry>

	<!-- protocolBinding retiree : identique au defaut defaultSamlEngineProperties.xml (HTTP-POST) -->

	<!-- Verifie utilises : DefaultCoreProperties.loadSecurityParams (pas de defaut) -->
	<entry key="eIDSectorShare">false</entry>
	<entry key="eIDCrossSectorShare">false</entry>
	<entry key="eIDCrossBorderShare">false</entry>

	<!-- friendlyName retiree : clef morte, jamais lue (ni SAMLCore, ni DefaultCoreProperties ;
	     les seules occurrences "friendlyName" du code sont l'attribut SAML RequestedAttribute.friendlyName,
	     une notion differente) -->

	<!--PEPS in the Service Provider's country - Verifie utilise : SAMLCore.REQUESTER_TAG (pas de defaut) -->
	<entry key="requester">http://S-PEPS.gov.xx</entry>

	<!--PEPS in the citizen's origin country - Verifie utilise : SAMLCore.RESPONDER_TAG (pas de defaut) -->
	<entry key="responder">http://C-PEPS.gov.xx</entry>

	<!-- timeNotOnOrAfter retiree : identique au defaut defaultSamlEngineProperties.xml (300) -->

	<!--Validation IP of the response - Verifie utilise : DefaultCoreProperties (pas de defaut) -->
	<entry key="ipAddrValidation">false</entry>

</properties>
