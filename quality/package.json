    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.3.1",
    "@types/node": "^22.18.8",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-chai-friendly": "^1.1.0",
    "eslint-plugin-cypress": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
