    "axe-core": "^4.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "commander": "^15.0.0",
    "csv-parser": "^3.2.0",
    "cypress": "15.21.1",
    "cypress-axe": "^1.7.0",
    "cypress-maildev": "^2.0.0",
    "cypress-on-fix": "^1.1.0",
    "cypress-plugin-api": "^2.11.2",
    "ejs": "^6.0.1",
    "esbuild": "^0.28.2",
    "jose": "^6.1.3",
    "luxon": "^3.7.2",
    "mongodb": "~7.5.0",
