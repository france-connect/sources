<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>
      Vous avez &eacute;t&eacute; ajout&eacute;(e) comme contributeur au fournisseur de service <%= locals.serviceProviderName %>
    </title>
    <style type="text/css">
      body {
        margin: 0;
        padding: 0;
        min-width: 100%;
        font-family: 'Helvetica Neue', Arial, sans-serif;
      }

      .content {
        width: 100%;
        max-width: 580px;
      }

      .header {
        padding: 24px 16px 8px 16px;
      }

      .innerpadding {
        padding: 0px 16px 24px 16px;
      }

      .bodycopy {
        color: #3A3A3A;
        font-family: 'Helvetica Neue', Arial, sans-serif;
        font-size: 16px;
        line-height: 24px;
        padding: 12px 0 0 0;
      }

      a {
        color: #000091;
        text-decoration: underline;
        font-weight: bold;
      }

      strong {
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <table
      width="100%"
      bgcolor="#ffffff"
      class="content"
      align="center"
      cellpadding="0"
      cellspacing="0"
      border="0"
    >
      <tr>
        <td class="header">
          <img
            src="https://franceconnect.gouv.fr/images/Marianne-FranceConnect-logo-10ans.png"
            height="98"
            border="0"
            alt="R&eacute;publique Fran&ccedil;aise - FranceConnect"
          />
        </td>
      </tr>
      <tr>
        <td class="innerpadding">
          <table width="100%" border="0" cellspacing="0" cellpadding="0">
            <tr>
              <td class="bodycopy">Bonjour,</td>
            </tr>
            <tr>
              <td class="bodycopy">
                Nous avons le plaisir de vous informer que
                <strong data-testid="add-contributor-email-added-by"><%= locals.addedByName %></strong>
                vous a ajout&eacute;(e) comme contributeur au fournisseur de service
                <strong data-testid="add-contributor-email-sp-name"><%= locals.serviceProviderName %></strong>
                sur l&rsquo;espace partenaires FranceConnect.
              </td>
            </tr>
            <tr>
              <td class="bodycopy">
                Vous pourrez acc&eacute;der aux fonctionnalit&eacute;s qui vous sont attribu&eacute;es et collaborer
                avec les autres membres de l&rsquo;organisation selon les droits associ&eacute;s &agrave; votre r&ocirc;le.
              </td>
            </tr>
            <tr>
              <td class="bodycopy">
                <a data-testid="add-contributor-email-sp-link" href="<%= locals.serviceProviderLink %>">Lien vers l&rsquo;espace partenaires</a>
              </td>
            </tr>
            <tr>
              <td class="bodycopy">
                Pour toute question ou difficult&eacute;, n&rsquo;h&eacute;sitez pas &agrave; contacter l&rsquo;administrateur
                du fournisseur de service ou notre &eacute;quipe de support.
              </td>
            </tr>
            <tr>
              <td class="bodycopy" style="padding-top: 24px;">Cordialement,</td>
            </tr>
            <tr>
              <td class="bodycopy" style="padding-top: 0;">L&rsquo;&eacute;quipe FranceConnect</td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
